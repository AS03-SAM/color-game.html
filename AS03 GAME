<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Color Guessing Game for Kids</title>
    <!-- Load Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Define the Inter font and set a smooth background */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f0f4f8; /* Light blue-gray background */
        }
        /* Style for the colored box - ensures it fills the space */
        #color-box {
            height: 150px;
            width: 150px;
            box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
            transition: background-color 0.3s ease;
        }
        /* Custom button style for a fun, bouncy effect */
        .color-button {
            transition: all 0.1s ease;
            box-shadow: 0 4px 0 0 #3b82f6; /* Blue shadow */
        }
        .color-button:active {
            transform: translateY(4px);
            box-shadow: none;
        }
    </style>
</head>
<body class="p-4 flex items-center justify-center min-h-screen">

    <div class="w-full max-w-md bg-white rounded-xl shadow-2xl p-6 md:p-8 space-y-6">

        <!-- Title and Scoreboard -->
        <header class="text-center space-y-2">
            <h1 class="text-3xl md:text-4xl font-extrabold text-blue-700">🌈 Color Quest!</h1>
            <p class="text-lg text-gray-600">Guess the color name below.</p>
            <div class="flex justify-center items-center space-x-6 pt-2">
                <span class="text-xl font-semibold text-green-600">Score: <span id="score">0</span></span>
                <span class="text-xl font-semibold text-red-600">Wrong: <span id="wrong-count">0</span></span>
            </div>
        </header>

        <!-- Color Display Area -->
        <div class="flex justify-center items-center">
            <div id="color-box" class="rounded-full border-4 border-gray-200">
                <!-- The color will be set dynamically by JavaScript -->
            </div>
        </div>

        <!-- Feedback Message Area -->
        <div class="text-center min-h-[40px] flex items-center justify-center">
            <p id="feedback" class="text-2xl font-bold transition duration-300"></p>
        </div>

        <!-- Button Grid for Choices -->
        <div id="button-container" class="grid grid-cols-2 gap-4">
            <!-- Buttons will be generated here by JavaScript -->
        </div>

    </div>

    <script>
        // Global Variables
        const COLORS = [
            { name: "Red", hex: "#ef4444" },
            { name: "Blue", hex: "#3b82f6" },
            { name: "Green", hex: "#10b981" },
            { name: "Yellow", hex: "#fcd34d" },
            { name: "Purple", hex: "#8b5cf6" },
            { name: "Orange", hex: "#f97316" },
            { name: "Pink", hex: "#ec4899" },
            { name: "Teal", hex: "#14b8a6" }
        ];

        let currentCorrectColor = '';
        let score = 0;
        let wrongCount = 0;

        // DOM Elements
        const colorBox = document.getElementById('color-box');
        const buttonContainer = document.getElementById('button-container');
        const scoreElement = document.getElementById('score');
        const wrongCountElement = document.getElementById('wrong-count');
        const feedbackElement = document.getElementById('feedback');

        /**
         * Selects a random set of four colors, one of which is the correct answer.
         */
        function generateNewQuestion() {
            // 1. Pick the correct color randomly
            const correctIndex = Math.floor(Math.random() * COLORS.length);
            const correctColor = COLORS[correctIndex];
            currentCorrectColor = correctColor.name;

            // 2. Select 3 incorrect colors
            let availableColors = COLORS.filter((_, index) => index !== correctIndex);
            // Shuffle and slice to get 3 unique wrong colors
            availableColors.sort(() => 0.5 - Math.random());
            const wrongColors = availableColors.slice(0, 3);

            // 3. Combine all 4 choices and shuffle them for button placement
            let choices = [...wrongColors, correctColor];
            choices.sort(() => 0.5 - Math.random());

            // 4. Update the visual display
            colorBox.style.backgroundColor = correctColor.hex;
            feedbackElement.textContent = ''; // Clear feedback

            // 5. Generate and display buttons
            buttonContainer.innerHTML = ''; // Clear old buttons

            choices.forEach(color => {
                const button = document.createElement('button');
                button.textContent = color.name.toUpperCase();
                button.setAttribute('data-color', color.name);
                button.className = `color-button w-full py-3 font-semibold rounded-lg text-white bg-blue-500 hover:bg-blue-600 active:bg-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-300`;

                button.addEventListener('click', handleGuess);
                buttonContainer.appendChild(button);
            });
        }

        /**
         * Handles the user's color guess when a button is clicked.
         * @param {Event} event - The click event.
         */
        function handleGuess(event) {
            const guessedColor = event.target.getAttribute('data-color');
            let isCorrect = guessedColor === currentCorrectColor;

            if (isCorrect) {
                score++;
                feedbackElement.textContent = "🥳 Correct! Keep going!";
                feedbackElement.className = "text-2xl font-bold text-green-600 animate-pulse";
            } else {
                wrongCount++;
                feedbackElement.textContent = `❌ Nope! It was ${currentCorrectColor}.`;
                feedbackElement.className = "text-2xl font-bold text-red-600";
            }

            // Update scoreboard
            scoreElement.textContent = score;
            wrongCountElement.textContent = wrongCount;

            // Disable buttons temporarily
            Array.from(buttonContainer.children).forEach(btn => btn.disabled = true);

            // Wait a moment before presenting the next question
            setTimeout(() => {
                generateNewQuestion();
                feedbackElement.className = "text-2xl font-bold"; // Reset animation/color
            }, 1000);
        }

        // Initialize the game when the window loads
        window.onload = generateNewQuestion;
    </script>
</body>
</html>
